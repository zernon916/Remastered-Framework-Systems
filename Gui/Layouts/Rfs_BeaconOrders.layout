<?xml version="1.0" encoding="UTF-8"?>
<MyGUI type="Layout" version="3.2.0">
	<!-- Recipe Framework Survival — Beacon Orders (Rest/Defend/Farm/Collect/Oil + ally color). Author: DemonsDen126 -->
	<Widget type="Widget" skin="PanelEmpty" position_real="0 0 1 1" name="Root">
		<!-- NeedKey false: same as /menu. true swallowed ESC so Close was the only exit. -->
		<Property key="NeedKey" value="false"/>
		<Property key="NeedMouse" value="true"/>

		<Widget type="Widget" skin="BackgroundInteractableWide" position_real="0.18 0.04 0.64 0.92" name="MainPanel">
