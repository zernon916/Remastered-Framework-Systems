<?xml version="1.0" encoding="UTF-8"?>
<MyGUI type="Layout" version="3.2.0">
	<!-- Recipe Framework Survival — rename hijacked bot. Author: DemonsDen126 -->
	<Widget type="Widget" skin="PanelEmpty" position_real="0 0 1 1" name="Root">
		<Property key="NeedKey" value="false"/>
		<Property key="NeedMouse" value="true"/>

		<Widget type="Widget" skin="BackgroundInteractableWide" position_real="0.32 0.34 0.36 0.28" name="MainPanel">
			<Property key="NeedKey" value="false"/>
			<Property key="NeedMouse" value="true"/>
			<Property key="InheritsAlpha" value="false"/>

			<Widget type="TextBox" skin="TextBox" position_real="0.04 0.06 0.70 0.16" name="Title">
				<Property key="Caption" value="RENAME BOT"/>
				<Property key="FontName" value="SM_HeaderLarge_Wide"/>
				<Property key="TextAlign" value="Left VCenter"/>
			</Widget>
			<Widget type="Button" skin="PrimaryButton" position_real="0.76 0.06 0.20 0.16" name="CloseButton">
				<Property key="Caption" value="CLOSE"/>
				<Property key="FontName" value="SM_Button"/>
				<Property key="TextAlign" value="Center"/>
			</Widget>

			<Widget type="TextBox" skin="TextBox" position_real="0.04 0.26 0.92 0.14" name="Status">
				<Property key="Caption" value="Name shows above the bot with its number."/>
				<Property key="FontName" value="SM_Text"/>
				<Property key="TextAlign" value="Left VCenter"/>
			</Widget>

			<Widget type="EditBox" skin="EditBox" position_real="0.04 0.44 0.92 0.20" name="NameEdit">
				<Property key="Caption" value=""/>
				<Property key="FontName" value="SM_Text"/>
			</Widget>

			<Widget type="Button" skin="PrimaryButton" position_real="0.20 0.70 0.60 0.22" name="BtnApply">
				<Property key="Caption" value="APPLY"/>
				<Property key="FontName" value="SM_Button"/>
				<Property key="TextAlign" value="Center"/>
			</Widget>
		</Widget>
	</Widget>
</MyGUI>
