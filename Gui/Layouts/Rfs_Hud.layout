<?xml version="1.0" encoding="UTF-8"?>
<MyGUI type="Layout" version="3.2.0">
	<!-- Recipe Framework Survival HUD — original DemonsDen126 (clock + compass). Original DemonsDen126 assets. -->
	<Widget type="Widget" skin="PanelEmpty" position_real="0 0 1 1" name="RfsHudRoot">
		<Property key="NeedKey" value="false"/>
		<Property key="NeedMouse" value="false"/>

		<!-- Clock: just above top-left minimap (posIdx 4, sizeIdx 2: MARGIN+8 fy0, 22% vh ring). -->
		<Widget type="Widget" skin="ToggleButton" position_real="0.019 0.002 0.12 0.030" name="RfsClockPanel">
			<Property key="NeedKey" value="false"/>
			<Property key="NeedMouse" value="false"/>
			<Widget type="TextBox" skin="TextBox" position_real="0 0 1 1" name="RfsClockText">
				<Property key="Caption" value="00:00"/>
				<Property key="TextAlign" value="Center"/>
				<Property key="TextColour" value="1 1 1"/>
				<Property key="FontName" value="InventorySearchText"/>
				<Property key="FontHeight" value="24"/>
				<Property key="TextShadow" value="true"/>
				<Property key="NeedKey" value="false"/>
				<Property key="NeedMouse" value="false"/>
			</Widget>
		</Widget>

		<!-- Game Mode countdown: compact pill below the minimap, hidden unless the lock timer is running. -->
		<Widget type="Widget" skin="ToggleButton" position_real="0.019 0.134 0.16 0.024" name="RfsGameModePanel">
			<Property key="NeedKey" value="false"/>
			<Property key="NeedMouse" value="false"/>
			<Property key="Visible" value="false"/>
			<Widget type="TextBox" skin="TextBox" position_real="0 0 1 1" name="RfsGameModeText">
				<Property key="Caption" value="Game Mode locks in 05:00"/>
				<Property key="TextAlign" value="Center"/>
				<Property key="TextColour" value="1 0.921569 0.4"/>
				<Property key="FontName" value="InventorySearchText"/>
				<Property key="FontHeight" value="14"/>
				<Property key="TextShadow" value="true"/>
				<Property key="NeedKey" value="false"/>
				<Property key="NeedMouse" value="false"/>
			</Widget>
		</Widget>

		<!-- Heading readout: above the vanilla compass bar (top-center). -->
		<Widget type="Widget" skin="ToggleButton" position_real="0.455 0.006 0.09 0.026" name="RfsCompassPanel">
			<Property key="NeedKey" value="false"/>
			<Property key="NeedMouse" value="false"/>
			<Widget type="TextBox" skin="TextBox" position_real="0 0 1 1" name="RfsCompassText">
				<Property key="Caption" value="N 0°"/>
				<Property key="TextAlign" value="Center"/>
				<Property key="TextColour" value="0.85 0.92 1"/>
				<Property key="FontName" value="InventorySearchText"/>
				<Property key="FontHeight" value="18"/>
				<Property key="TextShadow" value="true"/>
				<Property key="NeedKey" value="false"/>
				<Property key="NeedMouse" value="false"/>
			</Widget>
		</Widget>

		<!-- Tool ammo (lower-right). Vanilla engine ammo HUD is covered by this always-on HUD. Keep visible with MiniMap. -->
		<Widget type="Widget" skin="PanelEmpty" position_real="0.82 0.76 0.16 0.08" name="RfsAmmoPanel">
			<Property key="NeedKey" value="false"/>
			<Property key="NeedMouse" value="false"/>
			<Property key="Visible" value="false"/>
			<Widget type="TextBox" skin="TextBox" position_real="0 0 1 1" name="RfsAmmoText">
				<Property key="Caption" value=""/>
				<Property key="TextAlign" value="Right Bottom"/>
				<Property key="TextColour" value="1 1 0.752941"/>
				<Property key="FontName" value="SM_NumberSmall"/>
				<Property key="FontHeight" value="32"/>
				<Property key="TextShadow" value="true"/>
				<Property key="TextShadowColour" value="0 0 0 0.4"/>
				<Property key="NeedKey" value="false"/>
				<Property key="NeedMouse" value="false"/>
			</Widget>
		</Widget>

		<!-- Block/creation overlay (left-center, away from MiniMap BL and ammo BR). -->
		<Widget type="Widget" skin="PanelEmpty" position_real="0.012 0.42 0.30 0.08" name="RfsOverlayPanel">
			<Property key="NeedKey" value="false"/>
			<Property key="NeedMouse" value="false"/>
			<Property key="Visible" value="false"/>
			<Widget type="TextBox" skin="TextBox" position_real="0 0 1 1" name="RfsOverlayText">
				<Property key="Caption" value=""/>
				<Property key="TextAlign" value="Left VCenter"/>
				<Property key="TextColour" value="0.85 1 0.55"/>
				<Property key="FontName" value="InventorySearchText"/>
				<Property key="FontHeight" value="16"/>
				<Property key="TextShadow" value="true"/>
				<Property key="WordWrap" value="true"/>
				<Property key="NeedKey" value="false"/>
				<Property key="NeedMouse" value="false"/>
			</Widget>
		</Widget>
		<!-- Held rechargeable cell charge (above hotbar). Pips, not hash meters. -->
		<Widget type="Widget" skin="PanelEmpty" position_real="0.38 0.825 0.24 0.045" name="RfsChargePanel">
			<Property key="NeedKey" value="false"/>
			<Property key="NeedMouse" value="false"/>
			<Property key="Visible" value="false"/>
			<Widget type="TextBox" skin="TextBox" position_real="0 0 1 0.42" name="RfsChargeLabel">
				<Property key="Caption" value="Charge 0%"/>
				<Property key="TextAlign" value="Center"/>
				<Property key="TextColour" value="1 0.9 0.35"/>
				<Property key="FontName" value="InventorySearchText"/>
				<Property key="FontHeight" value="16"/>
				<Property key="TextShadow" value="true"/>
				<Property key="NeedKey" value="false"/>
				<Property key="NeedMouse" value="false"/>
			</Widget>
			<Widget type="Widget" skin="PanelEmpty" position_real="0.05 0.48 0.90 0.48" name="RfsChargeTrack">
				<Property key="NeedKey" value="false"/>
				<Property key="NeedMouse" value="false"/>
				<Widget type="Button" skin="PropertyIndicator" name="RfsChargePip0" position_real="0.01 0.1 0.08 0.8">
					<Property key="NeedMouse" value="false"/>
					<Property key="NeedKey" value="false"/>
				</Widget>
				<Widget type="Button" skin="PropertyIndicator" name="RfsChargePip1" position_real="0.11 0.1 0.08 0.8">
					<Property key="NeedMouse" value="false"/>
					<Property key="NeedKey" value="false"/>
				</Widget>
				<Widget type="Button" skin="PropertyIndicator" name="RfsChargePip2" position_real="0.21 0.1 0.08 0.8">
					<Property key="NeedMouse" value="false"/>
					<Property key="NeedKey" value="false"/>
				</Widget>
				<Widget type="Button" skin="PropertyIndicator" name="RfsChargePip3" position_real="0.31 0.1 0.08 0.8">
					<Property key="NeedMouse" value="false"/>
					<Property key="NeedKey" value="false"/>
				</Widget>
				<Widget type="Button" skin="PropertyIndicator" name="RfsChargePip4" position_real="0.41 0.1 0.08 0.8">
					<Property key="NeedMouse" value="false"/>
					<Property key="NeedKey" value="false"/>
				</Widget>
				<Widget type="Button" skin="PropertyIndicator" name="RfsChargePip5" position_real="0.51 0.1 0.08 0.8">
					<Property key="NeedMouse" value="false"/>
					<Property key="NeedKey" value="false"/>
				</Widget>
				<Widget type="Button" skin="PropertyIndicator" name="RfsChargePip6" position_real="0.61 0.1 0.08 0.8">
					<Property key="NeedMouse" value="false"/>
					<Property key="NeedKey" value="false"/>
				</Widget>
				<Widget type="Button" skin="PropertyIndicator" name="RfsChargePip7" position_real="0.71 0.1 0.08 0.8">
					<Property key="NeedMouse" value="false"/>
					<Property key="NeedKey" value="false"/>
				</Widget>
				<Widget type="Button" skin="PropertyIndicator" name="RfsChargePip8" position_real="0.81 0.1 0.08 0.8">
					<Property key="NeedMouse" value="false"/>
					<Property key="NeedKey" value="false"/>
				</Widget>
				<Widget type="Button" skin="PropertyIndicator" name="RfsChargePip9" position_real="0.91 0.1 0.08 0.8">
					<Property key="NeedMouse" value="false"/>
					<Property key="NeedKey" value="false"/>
				</Widget>
			</Widget>
		</Widget>

		<!-- Paint ink (centered above the hotbar). Separate from rechargeable cell HUD. -->
		<Widget type="Widget" skin="PanelEmpty" position_real="0.38 0.846 0.24 0.040" name="RfsPaintPanel">
			<Property key="NeedKey" value="false"/>
			<Property key="NeedMouse" value="false"/>
			<Property key="Visible" value="false"/>
			<Widget type="TextBox" skin="TextBox" position_real="0 0 1 0.38" name="RfsPaintLabel">
				<Property key="Caption" value="Ink 100%"/>
				<Property key="TextAlign" value="Center"/>
				<Property key="TextColour" value="0.9 0.95 1"/>
				<Property key="FontName" value="InventorySearchText"/>
				<Property key="FontHeight" value="14"/>
				<Property key="TextShadow" value="true"/>
				<Property key="NeedKey" value="false"/>
				<Property key="NeedMouse" value="false"/>
			</Widget>
			<Widget type="Widget" skin="PanelEmpty" position_real="0.02 0.46 0.96 0.48" name="RfsPaintTrack">
				<Property key="NeedKey" value="false"/>
				<Property key="NeedMouse" value="false"/>
				<Widget type="Button" skin="PropertyIndicator" name="RfsPaintPip0" position_real="0.01 0.1 0.08 0.8">
					<Property key="NeedMouse" value="false"/>
					<Property key="NeedKey" value="false"/>
				</Widget>
				<Widget type="Button" skin="PropertyIndicator" name="RfsPaintPip1" position_real="0.11 0.1 0.08 0.8">
					<Property key="NeedMouse" value="false"/>
					<Property key="NeedKey" value="false"/>
				</Widget>
				<Widget type="Button" skin="PropertyIndicator" name="RfsPaintPip2" position_real="0.21 0.1 0.08 0.8">
					<Property key="NeedMouse" value="false"/>
					<Property key="NeedKey" value="false"/>
				</Widget>
				<Widget type="Button" skin="PropertyIndicator" name="RfsPaintPip3" position_real="0.31 0.1 0.08 0.8">
					<Property key="NeedMouse" value="false"/>
					<Property key="NeedKey" value="false"/>
				</Widget>
				<Widget type="Button" skin="PropertyIndicator" name="RfsPaintPip4" position_real="0.41 0.1 0.08 0.8">
					<Property key="NeedMouse" value="false"/>
					<Property key="NeedKey" value="false"/>
				</Widget>
				<Widget type="Button" skin="PropertyIndicator" name="RfsPaintPip5" position_real="0.51 0.1 0.08 0.8">
					<Property key="NeedMouse" value="false"/>
					<Property key="NeedKey" value="false"/>
				</Widget>
				<Widget type="Button" skin="PropertyIndicator" name="RfsPaintPip6" position_real="0.61 0.1 0.08 0.8">
					<Property key="NeedMouse" value="false"/>
					<Property key="NeedKey" value="false"/>
				</Widget>
				<Widget type="Button" skin="PropertyIndicator" name="RfsPaintPip7" position_real="0.71 0.1 0.08 0.8">
					<Property key="NeedMouse" value="false"/>
					<Property key="NeedKey" value="false"/>
				</Widget>
				<Widget type="Button" skin="PropertyIndicator" name="RfsPaintPip8" position_real="0.81 0.1 0.08 0.8">
					<Property key="NeedMouse" value="false"/>
					<Property key="NeedKey" value="false"/>
				</Widget>
				<Widget type="Button" skin="PropertyIndicator" name="RfsPaintPip9" position_real="0.91 0.1 0.08 0.8">
					<Property key="NeedMouse" value="false"/>
					<Property key="NeedKey" value="false"/>
				</Widget>
			</Widget>
		</Widget>
	</Widget>
</MyGUI>
