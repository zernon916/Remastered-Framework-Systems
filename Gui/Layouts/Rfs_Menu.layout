<?xml version="1.0" encoding="UTF-8"?>
<MyGUI type="Layout" version="3.2.0">
	<!-- Recipe Framework Survival /menu — player panel (Recipe Radar style skins). Author: DemonsDen126 -->
	<Widget type="Widget" skin="PanelEmpty" position_real="0 0 1 1" name="Root">
		<Property key="NeedKey" value="false"/>
		<Property key="NeedMouse" value="true"/>

		<Widget type="Widget" skin="BackgroundInteractableWide" position_real="0.28 0.04 0.44 0.92" name="MainPanel">
			<Property key="NeedKey" value="false"/>
			<Property key="NeedMouse" value="true"/>
			<Property key="InheritsAlpha" value="false"/>

			<Widget type="TextBox" skin="TextBox" position_real="0.04 0.015 0.68 0.05" name="Title">
				<Property key="Caption" value="RFS MENU"/>
				<Property key="FontName" value="SM_HeaderLarge_Wide"/>
				<Property key="TextAlign" value="Left VCenter"/>
			</Widget>
			<Widget type="Button" skin="PrimaryButton" position_real="0.74 0.015 0.22 0.05" name="CloseButton">
				<Property key="Caption" value="CLOSE"/>
				<Property key="FontName" value="SM_Button"/>
				<Property key="TextAlign" value="Center"/>
			</Widget>

			<Widget type="TextBox" skin="TextBox" position_real="0.04 0.07 0.92 0.04" name="Status">
				<Property key="Caption" value="Per-player options — available to everyone"/>
				<Property key="FontName" value="SM_TextLabel"/>
				<Property key="TextAlign" value="Left VCenter"/>
			</Widget>

			<Widget type="Button" skin="PrimaryButton" position_real="0.08 0.115 0.84 0.055" name="BtnMap">
				<Property key="Caption" value="Map: craft GPS"/>
				<Property key="FontName" value="SM_Button"/>
				<Property key="TextAlign" value="Center"/>
			</Widget>
			<Widget type="Button" skin="PrimaryButton" position_real="0.08 0.175 0.84 0.055" name="BtnGrowthOverlay">
				<Property key="Caption" value="Growth Time: OFF"/>
				<Property key="FontName" value="SM_Button"/>
				<Property key="TextAlign" value="Center"/>
			</Widget>
			<Widget type="Button" skin="PrimaryButton" position_real="0.08 0.235 0.84 0.055" name="BtnBlockOverlay">
				<Property key="Caption" value="Block overlay: OFF"/>
				<Property key="FontName" value="SM_Button"/>
				<Property key="TextAlign" value="Center"/>
			</Widget>

			<Widget type="TextBox" skin="TextBox" position_real="0.04 0.30 0.92 0.04" name="GuiSection">
				<Property key="Caption" value="GUI"/>
				<Property key="FontName" value="SM_Header"/>
				<Property key="TextAlign" value="Left VCenter"/>
			</Widget>
			<Widget type="Button" skin="PrimaryButton" position_real="0.08 0.345 0.84 0.055" name="BtnNames">
				<Property key="Caption" value="Names: ON"/>
				<Property key="FontName" value="SM_Button"/>
				<Property key="TextAlign" value="Center"/>
			</Widget>
			<Widget type="Button" skin="PrimaryButton" position_real="0.08 0.405 0.84 0.055" name="BtnBigRed">
				<Property key="Caption" value="Big Red: OFF"/>
				<Property key="FontName" value="SM_Button"/>
				<Property key="TextAlign" value="Center"/>
			</Widget>
			<Widget type="Button" skin="PrimaryButton" position_real="0.08 0.465 0.84 0.055" name="BtnEnemyHp">
				<Property key="Caption" value="Enemy bar: Red"/>
				<Property key="FontName" value="SM_Button"/>
				<Property key="TextAlign" value="Center"/>
			</Widget>
			<Widget type="Button" skin="PrimaryButton" position_real="0.08 0.525 0.84 0.055" name="BtnNeutralHp">
				<Property key="Caption" value="Neutral bar: Green"/>
