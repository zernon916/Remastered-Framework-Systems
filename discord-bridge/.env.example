# Discord application bot token (Developer Portal → Bot → Reset Token)
DISCORD_TOKEN=

# Application (client) ID — required to register slash commands
CLIENT_ID=
# Legacy alias (still accepted by the bot):
# DISCORD_CLIENT_ID=

# Guild (server) ID — register guild commands instantly (recommended while testing)
GUILD_ID=
# Legacy alias:
# DISCORD_GUILD_ID=

# Absolute path to the vote JSON file Scrap Mechanic will poll.
# Default (if empty): ./inbox/vote.json relative to this discord-bridge folder.
# Local Custom Game (writable pack folder), e.g. C:\sm\RFS:
#   DROP_PATH=C:\sm\RFS\discord-bridge\inbox\vote.json
# Workshop / read-only content: write under Scrap Mechanic USER_DATA instead, e.g.
#   %AppData%\Axolot Games\Scrap Mechanic\User\User_<id>\rfs_discord_bridge\vote.json
# and set the same path here. RfsStreamer.lua polls both CONTENT and USER_DATA candidates.
DROP_PATH=

# Optional: restrict /vote to a single channel (Developer Mode → Copy Channel ID)
VOTE_CHANNEL_ID=

# Optional: require this role to /vote (ignored when ALLOW_EVERYONE_VOTES=true)
# Developer Mode → right-click role → Copy Role ID
STREAMER_ROLE_ID=

# If true, anyone in the server may /vote (default false)
ALLOW_EVERYONE_VOTES=false

# Seconds between votes per Discord user (default 15)
VOTE_COOLDOWN_SEC=15

# --- Chat relay (Discord → chat.jsonl + chat_inbox.json → in-game) ---
# When true, append Discord messages (requires Message Content Intent)
CHAT_RELAY_ENABLED=false
# Only listen in this channel when relay is enabled (safe no-op if unset)
CHAT_CHANNEL_ID=
# Optional absolute path; default is ./inbox/chat.jsonl (companion chat_inbox.json beside it)
# CHAT_RELAY_PATH=
# In-game: /gensettings → Discord chat relay ON (RfsFeatures.streamerChatRelayEnabled)
