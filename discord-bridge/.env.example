# Discord application bot token (Developer Portal → Bot → Reset Token)
DISCORD_TOKEN=

# Application (client) ID — required to register slash commands
CLIENT_ID=
# Legacy alias (still accepted by the bot):
# DISCORD_CLIENT_ID=

# Guild (server) ID — register guild commands instantly (recommended while testing)
GUILD_ID=
# Legacy alias:
# DISCORD_GUILD_ID=

# Absolute path to the vote JSON file Scrap Mechanic will poll.
# Default (if empty): ./inbox/vote.json relative to this discord-bridge folder.
# Always prefer an explicit DROP_PATH that matches what RfsStreamer.lua can read.
#
# --- Windows examples ---
# Local writable Custom Game pack:
#   DROP_PATH=C:\sm\RFS\discord-bridge\inbox\vote.json
# Workshop / read-only content — write under Scrap Mechanic USER_DATA:
#   DROP_PATH=%AppData%\Axolot Games\Scrap Mechanic\User\User_<id>\rfs_discord_bridge\vote.json
#   (expand %AppData% to the real path, e.g. C:\Users\<you>\AppData\Roaming\...)
#
# --- Linux examples (native or Proton) ---
# Native-style user data (if present):
#   DROP_PATH=/home/<you>/.local/share/Axolot Games/Scrap Mechanic/User/User_<id>/rfs_discord_bridge/vote.json
# Steam Proton (Scrap Mechanic appid 387990) — common layout:
#   DROP_PATH=/home/<you>/.steam/steam/steamapps/compatdata/387990/pfx/drive_c/users/steamuser/AppData/Roaming/Axolot Games/Scrap Mechanic/User/User_<id>/rfs_discord_bridge/vote.json
# Flatpak Steam often uses:
#   ~/.var/app/com.valvesoftware.Steam/.local/share/Steam/steamapps/compatdata/387990/...
#
# --- macOS ---
# Scrap Mechanic itself almost never runs on Mac. Run this bot on the Win/Linux
# host PC, or point DROP_PATH at a path the SM host can see (share/NFS/etc.).
#
# RfsStreamer.lua polls both CONTENT and USER_DATA candidates; DROP_PATH must be one of them.
DROP_PATH=

# Optional: absolute path to rfs_discord_bridge for npm run watch (skip User_* scan)
# RFS_BRIDGE_REQUEST_DIR=

# Optional: restrict /vote to a single channel (Developer Mode → Copy Channel ID)
VOTE_CHANNEL_ID=

# Optional: channel for apply/reject announcements (Phase C vote_result.json).
# If empty, falls back to VOTE_CHANNEL_ID. Bot polls vote_result.json beside DROP_PATH.
RESULT_CHANNEL_ID=

# Optional absolute path to vote_result.json (default: same folder as DROP_PATH → vote_result.json)
# RESULT_PATH=

# Optional: require this role to /vote (ignored when ALLOW_EVERYONE_VOTES=true)
# Developer Mode → right-click role → Copy Role ID
STREAMER_ROLE_ID=

# If true, anyone in the server may /vote (default false)
ALLOW_EVERYONE_VOTES=false

# Seconds between votes per Discord user (default 15)
VOTE_COOLDOWN_SEC=15

# --- Chat relay (Discord → chat.jsonl + chat_inbox.json → in-game) ---
# When true, append Discord messages (requires Message Content Intent)
CHAT_RELAY_ENABLED=false
# Only listen in this channel when relay is enabled (safe no-op if unset)
CHAT_CHANNEL_ID=
# Optional absolute path; default is ./inbox/chat.jsonl (companion chat_inbox.json beside it)
# CHAT_RELAY_PATH=
# In-game: /gensettings → Discord chat relay ON (RfsFeatures.streamerChatRelayEnabled)

# --- Chat outbox (game → Discord, Phase D) ---
# Defaults to same enable as CHAT_RELAY_ENABLED when unset.
# CHAT_OUTBOX_ENABLED=true
# Post target: CHAT_CHANNEL_ID, or OUT_CHANNEL_ID if chat channel unset
# OUT_CHANNEL_ID=
# Optional absolute path (default: inbox/chat_outbox.json beside DROP_PATH / chat relay)
# CHAT_OUTBOX_PATH=
# In-game: Streamer ON + Discord chat relay ON, then /say hello world  (or /d)
